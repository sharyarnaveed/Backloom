{
  "name": "backloom",
  "version": "0.1.1",
  "description": "Production-ready backend project generator",
  "type": "module",
  "bin": {
    "backloom": "dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "node --import tsx --test",
    "prepack": "node scripts/use-npm-readme.cjs",
    "postpack": "node scripts/restore-github-readme.cjs"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "scaffolding"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^26.4.0",
    "semantic-release": "^24.2.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
